# Blissful Gigs backend configuration — TEMPLATE. Copy to `.env` OUTSIDE the web root and fill in.
# Never commit a real .env. Generate secrets with the commands shown.

# development | testing | staging | production
APP_ENV=staging
# Public base URL, no trailing slash
APP_URL=https://app.blissfulevents.co.zw
# 32 random bytes, base64:  php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=REPLACE_WITH_BASE64_32_BYTES

# MySQL / MariaDB (create in DirectAdmin → MySQL Management). Use a STAGING-only database and user.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_dbname
DB_USER=REPLACE_dbuser
DB_PASS=REPLACE_db_password

# Absolute path to a writable folder OUTSIDE public_html (logs, uploads, cache)
STORAGE_PATH=/home/REPLACE_USER/blissful-gigs/storage

# Email: `mail` uses the host's mail server; `log` writes to storage/mail (development only)
MAIL_DRIVER=mail
MAIL_FROM=no-reply@blissfulevents.co.zw
SUPPORT_EMAIL=support@blissfulevents.co.zw

# Payments. Staging must stay on `sandbox` unless Paynow TEST credentials are supplied.
PAYMENT_PROVIDER=sandbox
# Random string:  php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
SANDBOX_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_HEX
# Paynow (only when PAYMENT_PROVIDER=paynow). PAYNOW_MODE=test until written go-live approval.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MODE=test
# Must stay false on staging. Production go-live only, after authorisation.
PAYMENTS_LIVE_ENABLED=false

# Push notifications (optional): path to the Firebase service-account JSON, stored OUTSIDE public_html, chmod 600
FCM_SERVICE_ACCOUNT_FILE=

# Test APK download: file path and optional HTTP Basic credentials for testers
TEST_APK_PATH=/home/REPLACE_USER/blissful-gigs/storage/app/blissful-gigs-testing.apk
DOWNLOAD_USER=testers
DOWNLOAD_PASS=REPLACE_WITH_TESTER_PASSWORD
