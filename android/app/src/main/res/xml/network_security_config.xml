<?xml version="1.0" encoding="utf-8"?>
<!-- Staging and release: HTTPS only, system CAs only. User-installed CAs are not trusted (MASVS-NETWORK-1). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
